{% extends 'base.html.twig' %}

{% block title %}WeatherRecord index{% endblock %}

{% block body %}
    <h1>WeatherRecord index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Temperature</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for weather_record in weather_records %}
            <tr>
                <td>{{ weather_record.id }}</td>
                <td>{{ weather_record.date ? weather_record.date|date('Y-m-d') : '' }}</td>
                <td>{{ weather_record.temperature }}</td>
                <td>
                    <a href="{{ path('app_weather_record_show', {'id': weather_record.id}) }}">show</a>
                    <a href="{{ path('app_weather_record_edit', {'id': weather_record.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_weather_record_new') }}">Create new</a>
{% endblock %}
